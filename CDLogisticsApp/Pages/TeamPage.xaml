<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CDLogisticsApp.Pages.TeamPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Notre Équipe" Style="{StaticResource TitleLabel}" HorizontalOptions="Center"/>

            <Grid ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Column="0" Spacing="10" HorizontalOptions="Center">
                    <Image Source="john.png" HeightRequest="100"/>
                    <Label Text="John Doe" Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"/>
                    <Label Text="CEO" Style="{StaticResource BodyLabel}" HorizontalOptions="Center"/>
                </StackLayout>

                <StackLayout Grid.Column="1" Spacing="10" HorizontalOptions="Center">
                    <Image Source="jane.png" HeightRequest="100"/>
                    <Label Text="Jane Smith" Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"/>
                    <Label Text="Manager" Style="{StaticResource BodyLabel}" HorizontalOptions="Center"/>
                </StackLayout>

                <StackLayout Grid.Column="2" Spacing="10" HorizontalOptions="Center">
                    <Image Source="aliou.png" HeightRequest="100"/>
                    <Label Text="Aliou Diallo" Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"/>
                    <Label Text="Logisticien" Style="{StaticResource BodyLabel}" HorizontalOptions="Center"/>
                </StackLayout>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
