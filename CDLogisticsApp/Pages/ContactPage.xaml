<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CDLogisticsApp.Pages.ContactPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Contactez-nous" Style="{StaticResource TitleLabel}" HorizontalOptions="Center"/>

            <Entry x:Name="NameEntry" Placeholder="Nom complet" />
            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
            <Editor x:Name="MessageEditor" Placeholder="Votre message" HeightRequest="120"/>
            <Button Text="Envoyer" Style="{StaticResource PrimaryButton}" Clicked="OnSendClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
