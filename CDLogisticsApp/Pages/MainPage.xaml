<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CDLogisticsApp.Pages.MainPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <Image Source="hero.jpg" Aspect="AspectFill" HeightRequest="250" />

            <Label Text="Bienvenue chez CD Logistics" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />

            <Label Text="Nous fournissons des solutions de transport et logistique efficaces pour votre entreprise." 
                   Style="{StaticResource BodyLabel}" HorizontalOptions="Center" />

            <Button Text="Voir nos services" Style="{StaticResource PrimaryButton}" Clicked="OnServicesClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
